PORT=3000
NODE_ENV=development
ADMIN_USERNAME=change-me
# Generate with: ADMIN_PASSWORD='your-password' npm run hash-password
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=
ADMIN_MFA_REQUIRED=false
# Use the public backend origin in production, for example https://www.cryptotrade.agency
APP_ORIGIN=http://localhost:3000
